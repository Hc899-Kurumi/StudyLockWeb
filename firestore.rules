rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user can only read and write their own subtree.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Pairing codes: the owner creates them; the extension (signed in) may read
    // a code to claim it, and update it to mark it claimed. Codes are short-lived.
    match /pairingCodes/{code} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null;
      allow update: if request.auth != null
                    && request.resource.data.claimed == true;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
